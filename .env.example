# ─────────────────────────────────────────────────────────────
# ONDOL — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Models (change to gpt-4o-mini for all calls to reduce cost)
ROUTER_MODEL=gpt-4o-mini
AGENT_MODEL=gpt-4o

# ── App ───────────────────────────────────────────────────────
SECRET_KEY=ondol-change-me-in-production
FLASK_PORT=5001
DEBUG=false

# ── Cost limits ───────────────────────────────────────────────
# Maximum USD spend per session (0 = no limit)
MAX_COST_PER_SESSION=1.00
# Maximum tokens per single agent call
MAX_TOKENS_PER_CALL=1500

# ── Cache ─────────────────────────────────────────────────────
# Seconds to cache identical SQL query results (0 = disabled)
CACHE_TTL=300
